CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/BUTTSDKFramework" "${PODS_ROOT}/BUTTSDKFramework/TTSDKFramework/TTSDKCore" "${PODS_ROOT}/BUTTSDKFramework/TTSDKFramework/TTSDKLiveBase" "${PODS_ROOT}/BUTTSDKFramework/TTSDKFramework/TTSDKLivePlayerLite" "${PODS_ROOT}/BUTTSDKFramework/TTSDKFramework/TTSDKLivePullVolcLog" "${PODS_ROOT}/BUTTSDKFramework/TTSDKFramework/TTSDKPlayerCoreLiveLite" "${PODS_ROOT}/BUTTSDKFramework/TTSDKFramework/TTSDKReachability" "${PODS_ROOT}/BUTTSDKFramework/TTSDKFramework/TTSDKStrategyLite" "${PODS_ROOT}/BUTTSDKFramework/TTSDKFramework/TTSDKTTFFmpegLiveLite" "${PODS_ROOT}/BUTTSDKFramework/TTSDKFramework/TTSDKVolcLog" "${PODS_XCFRAMEWORKS_BUILD_DIR}/BUTTSDKFramework/Core" "${PODS_XCFRAMEWORKS_BUILD_DIR}/BUTTSDKFramework/LiveBase" "${PODS_XCFRAMEWORKS_BUILD_DIR}/BUTTSDKFramework/LivePlayer/Lite" "${PODS_XCFRAMEWORKS_BUILD_DIR}/BUTTSDKFramework/LivePull-VolcLog" "${PODS_XCFRAMEWORKS_BUILD_DIR}/BUTTSDKFramework/PlayerCore/LiveLite" "${PODS_XCFRAMEWORKS_BUILD_DIR}/BUTTSDKFramework/Reachability" "${PODS_XCFRAMEWORKS_BUILD_DIR}/BUTTSDKFramework/Strategy/Lite" "${PODS_XCFRAMEWORKS_BUILD_DIR}/BUTTSDKFramework/TTFFmpeg/LiveLite" "${PODS_XCFRAMEWORKS_BUILD_DIR}/BUTTSDKFramework/VolcLog"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/BUTTSDKFramework/TTSDKFramework.framework/Headers"
LD_RUNPATH_SEARCH_PATHS = $(inherited) '@executable_path/Frameworks' '@loader_path/Frameworks'
OTHER_LDFLAGS = $(inherited) -ObjC -l"stdc++" -l"z" -framework "TTFFmpeg" -framework "TTSDKCore" -framework "TTSDKFramework" -framework "TTSDKLiveBase" -framework "TTSDKLivePlayerLite" -framework "TTSDKLivePullVolcLog" -framework "TTSDKPlayerCoreLiveLite" -framework "TTSDKReachability" -framework "TTSDKStrategyLite" -framework "TTSDKTTFFmpegLiveLite" -framework "TTSDKVolcLog" -framework "VolcBaseLog" -weak_framework "AVFoundation" -weak_framework "AudioToolBox" -weak_framework "CoreML" -weak_framework "CoreMedia" -weak_framework "CoreMotion" -weak_framework "CoreTelephony" -weak_framework "MetalKit" -weak_framework "MetalPerformanceShaders" -weak_framework "MetricKit" -weak_framework "OpenAL" -weak_framework "SystemConfiguration" -weak_framework "VideoToolBox"
OTHER_MODULE_VERIFIER_FLAGS = $(inherited) "-F${PODS_CONFIGURATION_BUILD_DIR}/BUTTSDKFramework"
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
